APP_NAME="Arevantes CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
UPLOAD_MAX_KB=15360
CLAMAV_SOCKET=
AUDIT_RETENTION_YEARS=7
SECURITY_EVENT_RETENTION_YEARS=2
HEALTH_RETENTION_DAYS=90
MOBILE_OPERATION_RETENTION_DAYS=30
COMMERCIAL_FIELD_LOCATION_RETENTION_DAYS=30
COMMERCIAL_FIELD_ACTIVITY_RETENTION_DAYS=365
ACCESS_REVIEW_MONTHS=3

INERTIA_SSR_ENABLED=false
APP_TIMEZONE=Europe/Madrid
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.arevantes.mobile
APNS_PRIVATE_KEY=

COMPANY_LEGAL_NAME=Arevantes
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
COMPANY_PROVINCE=
COMPANY_COUNTRY=Spain
COMPANY_EMAIL=contact@arevantes.com
COMPANY_PHONE=
DEFAULT_HOURLY_COST=0
MILEAGE_RATE=0.26

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
PERFORMANCE_SLOW_REQUEST_MS=750
PERFORMANCE_LARGE_RESPONSE_BYTES=500000

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origins allowed to call the bearer-token mobile API.
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost:5173
MOBILE_TOKEN_EXPIRATION_MINUTES=43200
BACKUP_MIRROR_DISK=
BACKUP_RETENTION_DAYS=30
POSTGRES_BACKUP_ENABLED=false
POSTGRES_BACKUP_SOURCE_CONNECTION=pgsql
POSTGRES_BACKUP_DISK=backups
POSTGRES_BACKUP_PREFIX=database-backups/postgres
POSTGRES_BACKUP_ACCESS_KEY_ID=
POSTGRES_BACKUP_SECRET_ACCESS_KEY=
POSTGRES_BACKUP_REGION=auto
POSTGRES_BACKUP_BUCKET=
POSTGRES_BACKUP_ENDPOINT=
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
POSTGRES_BACKUP_ENCRYPTION_KEY=
POSTGRES_BACKUP_TIMEOUT_SECONDS=1800
POSTGRES_BACKUP_MAX_AGE_HOURS=36
POSTGRES_RESTORE_MAX_AGE_DAYS=8
POSTGRES_RESTORE_VERIFICATION_ENABLED=false
POSTGRES_RESTORE_CONNECTION=backup_restore
POSTGRES_RESTORE_URL=
POSTGRES_RESTORE_HOST=
POSTGRES_RESTORE_PORT=5432
POSTGRES_RESTORE_DATABASE=
POSTGRES_RESTORE_USERNAME=
POSTGRES_RESTORE_PASSWORD=
POSTGRES_RESTORE_SSLMODE=require
POSTGRES_RESTORE_ALLOW_SAME_HOST=false
POSTGRES_RESTORE_DATABASE_PATTERN="/(backup|restore|isolated|verify)/i"

AI_DEFAULT_PROVIDER=deepseek
AI_ASSISTANT_NAME=Arevia
AI_DEFAULT_EMBEDDING_PROVIDER=ollama
